#!/usr/bin/env bash
# bin/ entrypoint on the Bash-tool PATH (Claude Code adds a plugin's bin/ to PATH).
# $CLAUDE_PLUGIN_ROOT is NOT exported to model-run Bash (issue #11), so commands and
# skills invoke this bare name; it forwards to ../scripts/agy-migrate.py.
#
# Python (not bash) because the job is JSON merging, YAML frontmatter rewriting and
# 12k-char rule chunking — the repo already ships python3 scripts for the same reason.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Exit 16, the next free code in this plugin's contract (docs/TROUBLESHOOTING.md).
# 13 is "agy not on PATH" and 14 is "model unavailable" — a missing Python is
# neither, and reusing either would misreport the dependency that is actually absent.
. "$ROOT/scripts/find-python.sh"
need_python agy-migrate
exec "${PY[@]}" "$ROOT/scripts/agy-migrate.py" "$@"
